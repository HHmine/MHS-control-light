# Model / Agent settings (used by my_agent.py and JiuwenSwarm MCP)
API_BASE=https://api.openai.com/v1
API_KEY=replace-with-your-key
MODEL_NAME=gpt-5.6-sol
MODEL_PROVIDER=openai

# Device gateway settings
HOST=127.0.0.1
PORT=8000
DEVICE_BACKEND=simulated
DEVICE_SERVICE_URL=http://127.0.0.1:8000

# Independent light sensor: disabled, simulated, or tuya
SENSOR_BACKEND=disabled
SENSOR_LIGHT_THRESHOLD=10
SENSOR_VERIFY_TIMEOUT=6
SENSOR_VERIFY_POLL_INTERVAL=0.5

# Required only for SENSOR_BACKEND=tuya
TUYA_API_ENDPOINT=https://openapi.tuyacn.com
TUYA_ACCESS_ID=replace-with-access-id
TUYA_ACCESS_KEY=replace-with-access-key
TUYA_SENSOR_DEVICE_ID=replace-with-device-id
TUYA_SENSOR_DP_CODE=bright_value

# Execution mode: direct or aurea
EXECUTION_MODE=direct

# Required only for DEVICE_BACKEND=yeelight
BEDSIDE_LAMP_IP=replace-with-lamp-ip
BEDSIDE_LAMP_TOKEN=replace-with-lamp-token

# Required for EXECUTION_MODE=aurea. Power actions additionally require a sensor.
AUREA_SOURCE_ROOT=D:\\AI\\MHS\\aurea-agent-southbound-access\\src
