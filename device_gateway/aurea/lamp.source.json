  "actions": [
    {"action_id": "lamp.power_on", "native_name": "set_power on", "description": "Turn the bedside lamp on.", "parameters": [{"name": "power", "type": "boolean", "required": true, "value_domain": [true]}], "source_refs": ["project_device_inspection"]},
    {"action_id": "lamp.power_off", "native_name": "set_power off", "description": "Turn the bedside lamp off.", "parameters": [{"name": "power", "type": "boolean", "required": true, "value_domain": [false]}], "source_refs": ["project_device_inspection"]},
    {"action_id": "lamp.set_brightness", "native_name": "set_bright", "description": "Set lamp brightness from 1 to 100 percent.", "parameters": [{"name": "brightness", "type": "integer", "required": true, "unit": "percent"}], "source_refs": ["project_device_inspection"]},
    {"action_id": "lamp.set_color_temperature", "native_name": "set_ct_abx", "description": "Set lamp color temperature from 1700 to 6500 kelvin.", "parameters": [{"name": "color_temperature", "type": "integer", "required": true, "unit": "K"}], "source_refs": ["project_device_inspection"]}
