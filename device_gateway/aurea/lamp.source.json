    {"observation_id": "yeelight_readback.power", "native_name": "get_prop power", "observation_type": "PROPERTY_READ", "value_type": "boolean", "value_domain": [true, false], "source_refs": ["project_device_inspection"]},
    {"observation_id": "yeelight_readback.brightness", "native_name": "get_prop bright", "observation_type": "PROPERTY_READ", "value_type": "integer", "unit": "percent", "source_refs": ["project_device_inspection"]},
    {"observation_id": "yeelight_readback.color_temperature", "native_name": "get_prop ct", "observation_type": "PROPERTY_READ", "value_type": "integer", "unit": "K", "source_refs": ["project_device_inspection"]}
